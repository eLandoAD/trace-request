<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!--
			net6.0 and net7.0 dropped: both are past end of support (net7 May 2024, net6 Nov 2024),
			and Serilog.AspNetCore / Serilog.Extensions.Logging 10.x ship no assets for them, so
			keeping those targets would pin the whole Serilog stack to 7.x. net8.0 stays because it
			is LTS until Nov 2026.

			Version 10.0.0, not 3.0.0: 6.0.0 is already on nuget.org and is the numerically highest
			published version, so anything below it would never resolve as "latest". 10.0.0 also
			matches the primary target framework, which appears to be what 6.0.0 was doing.
		-->
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Title>elando.ELK.TraceLogging</Title>
		<Description>Trace logging in to microservices with custom Http Header</Description>
		<Copyright>own license</Copyright>
		<PackageTags>Logging Trace</PackageTags>
		<Version>10.0.0</Version>
		<!--
			GitHub Packages uses RepositoryUrl to link the published package to its repository, and
			the other eLandoAD libraries (Euroins.Contracts, Euroins.ServiceDefaults) all declare it.
		-->
		<RepositoryUrl>https://github.com/eLandoAD/trace-request</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageLicenseFile>License.md</PackageLicenseFile>
		<IncludeContentInPack>true</IncludeContentInPack>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="$(SolutionDir)License.md" Pack="true" PackagePath="" />
		<None Include="$(SolutionDir)README.md" Pack="true" PackagePath="" />
	</ItemGroup>

	<!--
		Every package below is Apache-2.0, MIT or BSD-3-Clause at the pinned version - verified
		against each nuspec's license expression. None of them gate features behind a commercial
		licence at any version, unlike MediatR (13+), AutoMapper (15+) or FluentAssertions (8+),
		which are deliberately absent here.
	-->
	<ItemGroup>
		<PackageReference Include="Google.Protobuf" Version="3.35.1" />
		<PackageReference Include="Grpc.Core.Api" Version="2.83.0" />
		<PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.3.11" />
		<PackageReference Include="Sentry.Serilog" Version="6.8.0" />
		<PackageReference Include="Serilog" Version="4.4.0" />
		<PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
		<PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
		<PackageReference Include="Serilog.Enrichers.Process" Version="3.0.0" />
		<PackageReference Include="Serilog.Enrichers.Thread" Version="4.0.0" />
		<PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
		<PackageReference Include="Serilog.Settings.Configuration" Version="10.0.1" />
		<PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
		<PackageReference Include="Serilog.Sinks.Elasticsearch" Version="10.0.0" />
		<!--
			6.19.0 was vulnerable to GHSA-59j7-ghrg-fj52 (DoS). The 6.x line is patched from 6.34.0;
			8.x also clears it and is the supported line. Safe here because the only API used is
			JwtSecurityTokenHandler.ReadJwtToken plus a custom "userId" claim lookup - "userId" is
			not in DefaultInboundClaimTypeMap, so the 7.0 claim-mapping changes do not affect it.
		-->
		<PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
	</ItemGroup>

	<!--
		No longer split per target framework. The Serilog 10.x stack requires
		Microsoft.Extensions.* >= 10.0.0 transitively even from its net8.0 assets, so pinning 8.0.x
		on net8.0 produced NU1605 package-downgrade errors. The 10.0.0 abstractions all ship net8.0
		assets, so one set covers both targets.
	-->
	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
	</ItemGroup>

</Project>
